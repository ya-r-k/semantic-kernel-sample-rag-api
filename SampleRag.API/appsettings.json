{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Authority": "",
    "Audience": "samplerag-api",
    "Issuer": "samplerag-api",
    "RequireHttpsMetadata": false
  },
  "VectorDbSettings": {
    "Url": "http://localhost:6334",
    "Collections": [
      {
        "CollectionName": "document-chunks",
        "VectorSize": 1024,
        "Distance": "Cosine",
        "Quantization": "Scalar"
      },
      { 
        "CollectionName": "documents",
        "VectorSize": 1024,
        "Distance": "Cosine",
        "Quantization": "Scalar"
      },
      {
        "CollectionName": "knowledge-groups",
        "VectorSize": 1024,
        "Distance": "Cosine",
        "Quantization": "Scalar"
      }
    ],
    "VectorSizes": {
      "all-minilm:22m": 384,
      "mxbai-embed-large:latest": 1024
    },
    "TextVectorSize": 384

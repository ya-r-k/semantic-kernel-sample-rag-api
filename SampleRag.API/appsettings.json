    "TextEmbeddingModel": "mxbai-embed-large:latest",
    "LongTextEmbeddingModel": ""
  },
  "DbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "samplerag"
  },
  "ConnectionStrings": {
    "Quartz": ""
  },
  "AllowedHosts": "*"
